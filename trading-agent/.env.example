# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. NEVER commit `.env`. Never paste these into chat.
# ---------------------------------------------------------------------------

# Which broker adapter to use: alpaca | sim
BROKER=alpaca

# "paper" = simulated money on Alpaca's servers (default, safe).
# "live"  = REAL MONEY. Requires LIVE_CONFIRM below to also be set.
ALPACA_ENV=paper

# From https://app.alpaca.markets  -> Home -> API Keys.
# Paper keys and live keys are DIFFERENT. Use the pair matching ALPACA_ENV.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Market data feed. "iex" is included on the free plan; "sip" needs a paid plan.
ALPACA_DATA_FEED=iex

# --- Hard money limits (all amounts in the account's base currency) ---------
# Total capital the agent is ever allowed to deploy. Start here.
MAX_DEPLOYED=50
# Largest single order the agent may place.
MAX_ORDER_NOTIONAL=15
# Smallest order worth placing (Alpaca's own floor is 1.00).
MIN_ORDER_NOTIONAL=2
# Stop trading for the day once equity falls this % below the day's opening equity.
DAILY_LOSS_LIMIT_PCT=4
# Stop trading permanently once equity falls this % below the high-water mark.
MAX_DRAWDOWN_PCT=25
# Cap on orders submitted per calendar day.
MAX_ORDERS_PER_DAY=6
# US pattern-day-trader guard: refuse to open a day trade beyond this count.
MAX_DAY_TRADES=2
# Percent of equity risked per trade, measured from entry down to the stop.
RISK_PER_TRADE_PCT=1.5

# --- Strategy --------------------------------------------------------------
# trend | meanrev
STRATEGY=trend
# Comma-separated. Liquid, fractionable US ETFs are the sane default at this size.
UNIVERSE=SPY,QQQ,IWM
# Max simultaneous open positions.
MAX_POSITIONS=2

# --- Safety ----------------------------------------------------------------
# Required, verbatim, to allow ALPACA_ENV=live to actually place orders.
LIVE_CONFIRM=
# If this file exists, the agent halts immediately without placing orders.
HALT_FILE=./HALT

# Where the decision journal lives.
DB_PATH=./agent.db
