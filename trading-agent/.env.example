# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. NEVER commit `.env`. Never paste these into chat.
# ---------------------------------------------------------------------------

# Which broker adapter to use: kraken | alpaca | sim
#   kraken - EUR-native, real money ONLY (no paper mode). Cheapest end-to-end
#            for a small Irish account once withdrawal costs are counted.
#   alpaca - US equities/ETFs, has a free paper environment.
#   sim    - fully offline simulator; no keys, no network, no money.
BROKER=kraken

# --- Kraken ----------------------------------------------------------------
# From kraken.com -> Settings -> API -> Create API key.
# Required permissions: "Query Funds", "Query Open Orders & Trades",
# "Query Closed Orders & Trades", "Create & Modify Orders", "Cancel Orders".
# Do NOT enable Withdraw Funds. The agent never needs it, and a key that
# cannot withdraw cannot be used to drain the account if it leaks.
KRAKEN_KEY=
KRAKEN_SECRET=

# Currency your Kraken balance is held in.
QUOTE_CURRENCY=EUR

# "paper" = simulated money on Alpaca's servers (default, safe).
# "live"  = REAL MONEY. Requires LIVE_CONFIRM below to also be set.
ALPACA_ENV=paper

# From https://app.alpaca.markets  -> Home -> API Keys.
# Paper keys and live keys are DIFFERENT. Use the pair matching ALPACA_ENV.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Market data feed. "iex" is included on the free plan; "sip" needs a paid plan.
ALPACA_DATA_FEED=iex

# --- Hard money limits (all amounts in the account's base currency) ---------
# Total capital the agent is ever allowed to deploy. Start here.
MAX_DEPLOYED=50
# Largest single order the agent may place.
MAX_ORDER_NOTIONAL=15
# Smallest order worth placing (Alpaca's own floor is 1.00).
MIN_ORDER_NOTIONAL=2
# Stop trading for the day once equity falls this % below the day's opening equity.
DAILY_LOSS_LIMIT_PCT=4
# Stop trading permanently once equity falls this % below the high-water mark.
MAX_DRAWDOWN_PCT=25
# Cap on orders submitted per calendar day.
MAX_ORDERS_PER_DAY=6
# US pattern-day-trader guard: refuse to open a day trade beyond this count.
MAX_DAY_TRADES=2
# Percent of equity risked per trade, measured from entry down to the stop.
RISK_PER_TRADE_PCT=1.5
# Ceiling on how far below entry a stop may sit. On a volatile instrument an
# ATR-derived stop can otherwise exceed the price itself, leaving the position
# effectively unprotected. Matters most for crypto.
MAX_STOP_DISTANCE_PCT=25

# --- Strategy --------------------------------------------------------------
# trend | meanrev
STRATEGY=trend
# Comma-separated.
#   For BROKER=kraken use EUR pairs, e.g. XBTEUR,ETHEUR,SOLEUR
#   For BROKER=alpaca use liquid fractionable US ETFs, e.g. SPY,QQQ,IWM
# Check `python -m agent preflight` — it verifies each pair's minimum order
# size against your limits, which is the binding constraint at this size.
UNIVERSE=XBTEUR,ETHEUR,SOLEUR
# Max simultaneous open positions.
MAX_POSITIONS=2

# --- Safety ----------------------------------------------------------------
# Required, verbatim, before ANY real-money order is placed. Kraken has no
# paper mode, so this is mandatory for BROKER=kraken regardless of other
# settings. The exact phrase is: I ACCEPT REAL MONEY LOSS
LIVE_CONFIRM=
# If this file exists, the agent halts immediately without placing orders.
HALT_FILE=./HALT

# Where the decision journal lives.
DB_PATH=./agent.db
